{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "nixpacksBuildImage": "ghcr.io/railwayapp/nixpacks:latest",
    "providers": ["python"]
  },
  "deploy": {
    "startCommand": "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --timeout-keep-alive 600 --timeout-graceful-shutdown 300",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30000,
    "healthcheckInterval": 60000,
    "healthcheckUpdatedAt": "2026-09-22T00:00:00.000Z"
  }
}
