# =====================================================================
# Aguardiente ABV Fiesta — Python Backend ENV EXAMPLE
# Railway Deploy. NO subas tu .env real al repo.
# =====================================================================

# ============= IA DE BACKGROUND REMOVAL =============
# Nombre del modelo ONNX de rembg. Opciones (mejor → peor calidad / más → menos rápido):
#   isnet-general-use  (mejor cabello, 4s CPU)
#   u2net              (balanceado, 2.8s CPU) ← RECOMENDADO POR DEFECTO
#   u2netp             (versión ligera, 1.5s CPU, menos calidad en cabello)
#   silueta            (muy rápido, mejor para selfies close-up)
REMBG_MODEL=u2net

# ============= BASE DE DATOS (Auditoría de fotos procesadas) =============
# ⚠️  🔥 EVITA COSTOS DE EGRESS EN RAILWAY 🔥  ⚠️
# NO USES el host público crossover.proxy.rlwy.net que te muestra Railway
# (el que compartiste en chat: postgresql://postgres:***@crossover.proxy.rlwy.net:56205/railway)
# ESE ES EL ENDPOINT PÚBLICO Y TE COBRA POR CADA BYTE QUE SALE.
#
# ✅ MÉTODO RECOMENDADO (0 egress $$$):
#   En el Dashboard del servicio Python en Railway → Settings → Variables →
#   → Variables compartidas / attach DB → haz click en "Connect" PostgreSQL
#   → Railway INYECTA AUTOMÁTICAMENTE DATABASE_URL con el HOST INTERNO
#     *.railway.internal (puerto 5432) — NO hay costo por tráfico interno.
#
# Si de todas formas quieres setearla MANUALMENTE para dev local, usa solo
# la cadena de conexión para tu máquina. En Railway DEJA QUE LO INYECTE.
DATABASE_URL=postgresql://postgres:TU_PASSWORD_INTERNO@xxxx.railway.internal:5432/railway

# ============= URL PÚBLICA DEL SERVICIO (para QR / foto final) =============
# Railway define esto como RAILWAY_STATIC_URL o RAILWAY_PUBLIC_DOMAIN — puedes
# setearlo explicitamente si usas dominio personalizado.
PUBLIC_URL=https://TU-PROYECTO-ABV.up.railway.app
RAILWAY_PUBLIC_DOMAIN=TU-PROYECTO-ABV.up.railway.app

# ============= STORAGE =============
# Carpeta donde se guardan las fotos finales (servidas vía /fotos/)
# En Railway monta un VOLUMEN persistente apuntando a /app/backend-python/public-fotos
# para que no se borren al redeployar.
STORAGE_DIR=./public-fotos
PUBLIC_ASSETS_DIR=../public/assets

# ============= PUERTO =============
# Railway lo inyecta automáticamente como PORT. En local default 8000.
PORT=8000
