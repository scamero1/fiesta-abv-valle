# ✅ Procfile EVENTO 10K — 4 tablets concurrentes.
# Workers 2 = 2 procesos Uvicorn (max paralelismo real en Railway 2 vCPU / 4GB)
# limit-concurrency 16 / backlog 2048 = aceptar conexiones sin saturar kernel TCP
# keep-alive 180s = no matar conexiones tablet 4G/latencia alta
web: export PATH=/opt/venv/bin:$PATH && export OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 MKL_NUM_THREADS=2 ORT_OMP_NUM_THREADS=2 NUMEXPR_NUM_THREADS=2 && uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 2 --limit-concurrency 16 --backlog 2048 --timeout-keep-alive 180 --timeout-graceful-shutdown 180
